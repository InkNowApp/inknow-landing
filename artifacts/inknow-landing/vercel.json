{
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "redirects": [
    {
      "source": "/join/:code",
      "destination": "https://inknow-production.up.railway.app/join/:code",
      "permanent": false
    }
  ]
}
